<?xml version="1.0" encoding="utf-8"?>
<!-- Nobar sheet (Chica): set up or join a room; inside a room, code card, members, requests, invite. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/ChicaSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nobar"
            android:textSize="22sp" />

        <!-- Not in a room -->
        <LinearLayout
            android:id="@+id/nobar_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/nobar_intro"
                android:textColor="?attr/grayTextColor"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/nobar_name"
                style="@style/ChicaSheetField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:autofillHints="name"
                android:hint="@string/nobar_name_hint"
                android:inputType="textPersonName"
                android:maxLength="40" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nobar_create"
                style="@style/ChicaDialogPrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginStart="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="0dp"
                android:text="@string/nobar_create"
                app:icon="@drawable/ic_baseline_people_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="?attr/account_unselected_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/nobar_code"
                    style="@style/ChicaSheetField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="no"
                    android:hint="@string/nobar_code_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:letterSpacing="0.08"
                    android:maxLength="64" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_join"
                    style="@style/ChicaDialogOutlineButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="0dp"
                    android:text="@string/nobar_join" />
            </LinearLayout>

            <EditText
                android:id="@+id/nobar_server"
                style="@style/ChicaSheetField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints="no"
                android:hint="@string/nobar_server_hint"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- In a room -->
        <LinearLayout
            android:id="@+id/nobar_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Room code card: tap the code to copy it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/chica_player_row"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/nobar_room_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:foreground="@drawable/outline_drawable_less"
                    android:fontFamily="@font/google_sans"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.2"
                    android:minHeight="48dp"
                    android:textColor="?attr/textColor"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="K7QMPZ" />

                <TextView
                    android:id="@+id/nobar_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="14sp"
                    tools:text="Sinkron" />

                <TextView
                    android:id="@+id/nobar_now_playing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/textColor"
                    android:textSize="14sp"
                    tools:text="Sedang diputar: Dune · S1:E2" />
            </LinearLayout>

            <!-- Asks from members without control: the host and co-hosts answer -->
            <TextView
                android:id="@+id/nobar_requests_title"
                style="@style/ChicaSheetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/nobar_requests"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/nobar_request_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Members without control ask instead; anyone but the host can ask for the seat -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/nobar_ask_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nobar_ask_pause"
                        style="@style/ChicaDialogChipButton"
                        android:layout_width="wrap_content"
                        android:text="@string/nobar_ask_pause" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nobar_ask_play"
                        style="@style/ChicaDialogChipButton"
                        android:layout_width="wrap_content"
                        android:text="@string/nobar_ask_play" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nobar_ask_host"
                        style="@style/ChicaDialogChipButton"
                        android:layout_width="wrap_content"
                        android:text="@string/nobar_ask_host" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                style="@style/ChicaSheetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nobar_members" />

            <LinearLayout
                android:id="@+id/nobar_member_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/nobar_everyone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/nobar_everyone_control"
                android:textColor="?attr/textColor"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_share"
                    style="@style/ChicaDialogPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:text="@string/nobar_share"
                    app:icon="@drawable/ic_outline_share_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_leave"
                    style="@style/ChicaDialogOutlineButton"
                    android:layout_width="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:text="@string/nobar_leave" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
