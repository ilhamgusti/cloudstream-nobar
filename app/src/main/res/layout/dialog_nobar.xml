<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingTop="20dp"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nobar"
            android:textColor="?attr/textColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Not in a room -->
        <LinearLayout
            android:id="@+id/nobar_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/nobar_intro"
                android:textColor="?attr/grayTextColor"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/nobar_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints="name"
                android:hint="@string/nobar_name_hint"
                android:inputType="textPersonName"
                android:maxLength="40"
                android:textColorHint="?attr/grayTextColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nobar_create"
                style="@style/WhiteButton"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/nobar_create"
                app:icon="@drawable/ic_baseline_people_24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/nobar_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="no"
                    android:hint="@string/nobar_code_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="64"
                    android:textColorHint="?attr/grayTextColor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_join"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:text="@string/nobar_join" />
            </LinearLayout>

            <EditText
                android:id="@+id/nobar_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="no"
                android:hint="@string/nobar_server_hint"
                android:inputType="textUri"
                android:textColorHint="?attr/grayTextColor"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- In a room -->
        <LinearLayout
            android:id="@+id/nobar_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/nobar_room_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:focusable="true"
                android:letterSpacing="0.2"
                android:textColor="?attr/textColor"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="K7QMPZ" />

            <TextView
                android:id="@+id/nobar_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/grayTextColor"
                android:textSize="14sp"
                tools:text="In sync" />

            <TextView
                android:id="@+id/nobar_now_playing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/textColor"
                android:textSize="14sp"
                tools:text="Now playing: Dune · S1:E2" />

            <!-- Asks from members without control: the host and co-hosts answer -->
            <TextView
                android:id="@+id/nobar_requests_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/nobar_requests"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/nobar_request_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Members without control ask instead; anyone but the host can ask for the seat -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/nobar_ask_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_ask_pause"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:text="@string/nobar_ask_pause" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_ask_play"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:text="@string/nobar_ask_play" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_ask_host"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:text="@string/nobar_ask_host" />
            </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/nobar_members"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/nobar_member_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/nobar_everyone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/nobar_everyone_control"
                android:textColor="?attr/textColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_share"
                    style="@style/WhiteButton"
                    android:layout_width="wrap_content"
                    android:text="@string/nobar_share"
                    app:icon="@drawable/ic_outline_share_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nobar_leave"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:text="@string/nobar_leave" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
