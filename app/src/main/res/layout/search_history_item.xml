<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_history_tab"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="@drawable/outline_drawable_less"
    android:foreground="?attr/selectableItemBackground"
    android:focusable="true"
    android:nextFocusRight="@id/home_history_remove"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/chica_lists_history_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/history_toggle_off_24px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/grayTextColor"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/home_history_title"
        style="@style/ChicaListsRowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/chica_lists_history_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/home_history_remove"
        tools:text="Hello World" />

    <ImageView
        android:id="@+id/home_history_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/outline_drawable_less"
        android:focusable="true"
        android:nextFocusLeft="@id/home_history_tab"
        android:padding="14dp"
        android:src="@drawable/ic_baseline_close_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/grayTextColor"
        tools:ignore="ContentDescription" />
</androidx.constraintlayout.widget.ConstraintLayout>
