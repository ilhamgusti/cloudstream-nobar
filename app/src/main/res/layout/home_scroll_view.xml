<?xml version="1.0" encoding="utf-8"?>
<!-- One hero page on Home: backdrop, plum scrim, title and meta bottom-left above the actions. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryGrayBackground">

    <ImageView
        android:id="@+id/home_scroll_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/example_poster" />

    <View
        android:id="@+id/title_shadow_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/title_shadow"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="bottom"
        android:background="@drawable/chica_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="76dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/home_preview_logo"
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:layout_gravity="start"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:paddingBottom="6dp"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/home_scroll_preview_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingBottom="4dp"
            android:textColor="@color/chicaInk"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="The Remarried Empress" />

        <TextView
            android:id="@+id/home_scroll_preview_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chicaInk"
            android:alpha="0.85"
            android:textSize="14sp"
            tools:text="Romantis • Drama • Fantasi" />
    </LinearLayout>

</FrameLayout>
