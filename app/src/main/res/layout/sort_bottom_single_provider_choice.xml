<?xml version="1.0" encoding="utf-8"?>
<!-- Provider pick row: same rounded plum selection as sort_bottom_single_choice, settings + pin at the end. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/chica_player_choice_bg"
    android:minHeight="52dp">

    <TextView
        android:id="@+id/text1"
        style="@style/CheckLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="16dp"
        android:minHeight="52dp"
        android:paddingStart="24dp"
        android:paddingEnd="104dp"
        android:textStyle="normal"
        tools:text="hello" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/action_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_settings"
            android:padding="12dp"
            android:src="@drawable/ic_baseline_tune_24"
            android:visibility="gone"
            app:tint="?attr/textColor"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/pinicon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/pin_ic"
            android:visibility="gone"
            app:tint="?attr/grayTextColor"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
