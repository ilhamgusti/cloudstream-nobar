<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="20dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <!-- Chica family brand mark at the top of the rail, like Chica TV. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:focusable="false"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/nav_header_brand"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/brand_mark" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:visibility="gone"
            android:id="@+id/nav_header_notification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:itemIconTint="@color/item_select_color"
            android:focusable="true"
            android:nextFocusRight="@id/home_preview_info_btt"
            android:src="@drawable/notifications_icon_selector"
            android:contentDescription="@string/account"
            app:tint="@color/item_select_color" />

</LinearLayout>