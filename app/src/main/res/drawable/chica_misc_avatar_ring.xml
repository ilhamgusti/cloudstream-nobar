<?xml version="1.0" encoding="utf-8"?>
<!-- Profile avatar ring: hairline at rest, blush ring on focus / hover / press (TV + touch). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="?attr/account_unselected_stroke" />
        </shape>
    </item>
</selector>
