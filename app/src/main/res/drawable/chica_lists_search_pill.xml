<?xml version="1.0" encoding="utf-8"?>
<!-- Chica pill search field: plum surface, hairline at rest, blush ring while the field (or a child) has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/primaryGrayBackground" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/primaryGrayBackground" />
            <stroke android:width="1dp" android:color="?attr/account_unselected_stroke" />
        </shape>
    </item>
</selector>
