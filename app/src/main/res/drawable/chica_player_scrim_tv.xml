<?xml version="1.0" encoding="utf-8"?>
<!-- TV player scrim: heavy plum at the bottom for the control row, soft at the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#00000000"
                android:centerY="0.35"
                android:endColor="#00000000"
                android:startColor="@color/chica_player_scrim_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:startColor="#80120E16" />
        </shape>
    </item>
</layer-list>
