<?xml version="1.0" encoding="utf-8"?>
<!-- TV player pill: blush fill when focused by the remote, dark translucent pill otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chica_player_pill_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/chica_player_pill_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
