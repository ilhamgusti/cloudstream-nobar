<?xml version="1.0" encoding="utf-8"?>
<!-- Centre play/pause: a dark translucent disc so the white glyph reads over any frame. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/video_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/chica_player_pill_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/chica_player_pill_stroke" />
        </shape>
    </item>
</ripple>
