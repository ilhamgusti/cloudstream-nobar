<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet text field: plum surface, 14dp corners, blush outline while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/primaryGrayBackground" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/primaryGrayBackground" />
            <stroke
                android:width="1dp"
                android:color="?attr/account_unselected_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
