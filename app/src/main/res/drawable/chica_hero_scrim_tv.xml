<?xml version="1.0" encoding="utf-8"?>
<!-- TV hero: plum fades in from the left and the bottom so the title block reads over any backdrop. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerX="0.45"
                android:centerColor="#991C1721"
                android:endColor="#001C1721"
                android:startColor="#F21C1721" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerY="0.35"
                android:centerColor="#001C1721"
                android:endColor="#001C1721"
                android:startColor="#CC1C1721" />
        </shape>
    </item>
</layer-list>
